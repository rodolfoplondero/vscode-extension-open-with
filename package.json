{
  "name": "open-with-external",
  "displayName": "Open With External Application",
  "description": "Open local files with compatible Windows applications from a searchable VS Code picker.",
  "version": "0.2.0",
  "publisher": "rodolfoplondero",
  "author": {
    "name": "Rodolfo Londero"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rodolfoplondero/vscode-extension-open-with.git"
  },
  "homepage": "https://github.com/rodolfoplondero/vscode-extension-open-with#readme",
  "bugs": {
    "url": "https://github.com/rodolfoplondero/vscode-extension-open-with/issues"
  },
  "keywords": [
    "open with",
    "external application",
    "windows",
    "file associations"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "Open With External Application",
      "properties": {
        "openWithExternal.preloadEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Preload application lists in the background for configured file types found in local workspace folders. Requires caching to be enabled."
        },
        "openWithExternal.preloadExtensions": {
          "type": "array",
          "default": [
            ".docx",
            ".xlsx",
            ".pptx",
            ".pdf",
            ".odt",
            ".ods",
            ".odp",
            ".rtf",
            ".md",
            ".txt",
            ".csv",
            ".json",
            ".xml",
            ".yaml",
            ".yml",
            ".py",
            ".html",
            ".css",
            ".js",
            ".ts",
            ".png",
            ".jpg",
            ".jpeg",
            ".svg",
            ".webp",
            ".drawio",
            ".bpmn"
          ],
          "items": {
            "type": "string",
            "pattern": "^\\.?[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "scope": "window",
          "description": "File extensions to preload when found in local workspace folders. Entries can include or omit the leading dot; capitalization is ignored. An empty list disables preloading."
        },
        "openWithExternal.cacheDurationMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "scope": "window",
          "description": "Minutes to reuse the discovered applications for each file extension. Set to 0 to disable caching. Changing this setting clears the cache. Use Refresh Applications in the picker to query Windows immediately."
        }
      }
    },
    "commands": [
      {
        "command": "openWithExternal.open",
        "title": "Open With External Application…",
        "category": "File",
        "enablement": "isWindows"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "openWithExternal.open",
          "when": "isWindows && resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "openWithExternal.open",
          "when": "isWindows && resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "command": "openWithExternal.open",
          "when": "isWindows && resourceScheme == file",
          "group": "navigation@20"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository --out open-with-external-0.2.0.vsix"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.1.1",
    "ovsx": "1.4.0",
    "typescript": "5.9.3"
  },
  "private": true,
  "dependencies": {
    "minimatch": "10.2.6"
  }
}
